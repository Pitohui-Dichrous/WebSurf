<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#000000</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F2F2F2</item>
        <item name="android:navigationBarColor">#F2F2F2</item>
        <item name="android:windowBackground">#F2F2F2</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppThemeDarkBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#C0FE03</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="AppThemeDark" parent="AppThemeDarkBase" />
</resources>
